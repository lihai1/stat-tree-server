# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GRPC_PORT=9090
GATEWAY_PORT=8080

# Database Configuration (shared Postgres, lottery schema)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=statistiloto
DB_SSLMODE=disable
DB_SCHEMA=lottery

# Auth (Keycloak JWT validation — defense-in-depth)
AUTH_ENABLED=true
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/statistiloto/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://localhost/auth/realms/statistiloto
KEYCLOAK_AUDIENCE=account

# Scraper / Seeder
LOTTERY_SCRAPER_CRON=0 3 * * *
LOTTERY_SEED_ON_BOOT=true
