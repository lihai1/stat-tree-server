{
  "swagger": "2.0",
  "info": {
    "title": "lottery.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "LotteryService",
      "description": "LotteryService is the contract between the Java BFF and the Go\nlottery-stats-server. The Go service owns the tree-based analysis engine\n(internal/lottery-tree) and the lottery_results store. It is stateless\nbeyond the historical draws table: no user data, no saved forms."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/generate/analyze": {
      "post": {
        "summary": "Analyze evaluates user-selected numbers against historical winning draws.",
        "operationId": "LotteryService_Analyze",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AnalyzeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "AnalyzeRequest mirrors the original FormAnalyzeCalculations model.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AnalyzeRequest"
            }
          }
        ],
        "tags": [
          "LotteryService"
        ]
      }
    },
    "/api/generate/form": {
      "post": {
        "summary": "GenerateForm generates lottery number combinations based on\nhistorical-draw patterns over an optional date window.",
        "operationId": "LotteryService_GenerateForm",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GenerateFormResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "GenerateFormRequest mirrors the original FormCalculations model.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1GenerateFormRequest"
            }
          }
        ],
        "tags": [
          "LotteryService"
        ]
      }
    },
    "/api/generate/pares": {
      "post": {
        "summary": "GetStatistics calculates frequent number pairs/groups over a date window.",
        "operationId": "LotteryService_GetStatistics",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetStatisticsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "GetStatisticsRequest mirrors the original statsCalculations model.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1GetStatisticsRequest"
            }
          }
        ],
        "tags": [
          "LotteryService"
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "HealthCheck returns the health status of the service.",
        "operationId": "LotteryService_HealthCheck",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1HealthCheckResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "LotteryService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AnalyzeRequest": {
      "type": "object",
      "properties": {
        "form": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "description": "The user's selected numbers to evaluate."
        },
        "window": {
          "$ref": "#/definitions/v1DateWindow",
          "description": "Optional historical window."
        }
      },
      "description": "AnalyzeRequest mirrors the original FormAnalyzeCalculations model."
    },
    "v1AnalyzeResponse": {
      "type": "object",
      "properties": {
        "frequency_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1FrequencyGroup"
          },
          "description": "Grouped frequency results, one entry per group size (1–6).\nEach group contains the number combinations of that size and their\noccurrence counts, mirroring the legacy 2D-array analyze output."
        },
        "archive_size": {
          "type": "integer",
          "format": "int32",
          "description": "Number of historical draws used for the analysis (archive size)."
        }
      },
      "description": "AnalyzeResponse is the analysis of the user's form against history."
    },
    "v1DateWindow": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "DateWindow is an optional historical-draw window. If both bounds are unset\nthe service uses the full archive."
    },
    "v1FrequencyEntry": {
      "type": "object",
      "properties": {
        "numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "description": "The numbers in this combination (length = group size)."
        },
        "count": {
          "type": "integer",
          "format": "int32",
          "description": "How many times this combination appeared in the archive."
        }
      },
      "description": "FrequencyEntry is one number combination and its occurrence count."
    },
    "v1FrequencyGroup": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "Group size: 1 = single number, 2 = pair, 3 = triple, etc."
        },
        "combos": {
          "type": "integer",
          "format": "int32",
          "description": "Total possible combinations for this group size (C(37, size))."
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1FrequencyEntry"
          },
          "description": "Frequency entries in this group, sorted by count descending."
        }
      },
      "description": "FrequencyGroup holds all frequency entries for a specific group size."
    },
    "v1GenerateFormRequest": {
      "type": "object",
      "properties": {
        "how_many": {
          "type": "integer",
          "format": "int32",
          "description": "howMany combinations to generate."
        },
        "form_type": {
          "type": "integer",
          "format": "int32",
          "description": "Lottery form type/variant (matches original `type` field)."
        },
        "will_be": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "description": "Numbers the user wants included in every generated form (\"willBe\")."
        },
        "window": {
          "$ref": "#/definitions/v1DateWindow",
          "description": "Optional historical window. Unset = full archive."
        },
        "strength": {
          "$ref": "#/definitions/v1Strength",
          "description": "Strength mode for statistics-aware generation."
        }
      },
      "description": "GenerateFormRequest mirrors the original FormCalculations model."
    },
    "v1GenerateFormResponse": {
      "type": "object",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1NumberSet"
          }
        }
      },
      "description": "GenerateFormResponse is a list of generated combinations."
    },
    "v1GetStatisticsRequest": {
      "type": "object",
      "properties": {
        "how_many": {
          "type": "integer",
          "format": "int32",
          "description": "how many pairs/groups to compute."
        },
        "form_type": {
          "type": "integer",
          "format": "int32",
          "description": "Lottery form type/variant."
        },
        "window": {
          "$ref": "#/definitions/v1DateWindow",
          "description": "Optional historical window."
        },
        "strength": {
          "$ref": "#/definitions/v1Strength",
          "description": "Strength mode (strong/weak pair statistics)."
        }
      },
      "description": "GetStatisticsRequest mirrors the original statsCalculations model."
    },
    "v1GetStatisticsResponse": {
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Pair"
          }
        }
      },
      "description": "GetStatisticsResponse is the list of frequent pairs/groups."
    },
    "v1HealthCheckResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "draws_loaded": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "HealthCheckResponse contains the health status of the service."
    },
    "v1NumberSet": {
      "type": "object",
      "properties": {
        "numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "strong": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "NumberSet is one generated combination (regular numbers + optional strong)."
    },
    "v1Pair": {
      "type": "object",
      "properties": {
        "numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "count": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "Pair is a frequent number group with its occurrence count."
    },
    "v1Strength": {
      "type": "string",
      "enum": [
        "STRENGTH_UNSPECIFIED",
        "WEAK",
        "STRONG"
      ],
      "default": "STRENGTH_UNSPECIFIED",
      "description": "Strength selects whether strong-ball statistics are used."
    }
  }
}
